it\": \"crores of ₹\",\n  \"period\": \"year ended 31 March 2025\",\n  \"basis\": \"Consolidated Balance Sheets of HCLTech and Tech Mahindra\",\n  \"citations\": [\n    \"document_id=9b92318dceffd61054f3d190bcfd9aa5311db94e38ae7eb72186821188295343 page=335\",\n    \"document_id=2daca49ad8951f51d570dd75f5876edf5265a93764a659097797cfc3bd5f0ef9 page=586\"\n  ],\n  \"abstain\": false,\n  \"reason\": \"The total equity for HCLTech is 69,673 crores of ₹, while for Tech Mahindra it is 27,361.5 crores of ₹, making HCLTech's total equity larger.\"\n}", "status": "answered", "usage": {"completion_tokens": 614, "prompt_tokens": 2513, "prompt_tokens_details": null, "total_tokens": 3127}}], "score": {"gold_abstain": false, "pred_abstain": false, "abstain_correct": true, "false_answer": false, "false_abstention": false, "gold_answer_kind": "entity", "pred_answer_kind": "numeric", "numeric_match": null, "entity_match": true, "citation_valid": false, "parse_ok": true}, "status": "answered", "usage": {"completion_tokens": 1550, "prompt_tokens": 7539, "total_tokens": 9089}, "score_v1": {"abstain_correct": true, "citation_valid": false, "entity_match": true, "false_abstention": false, "false_answer": false, "gold_abstain": false, "gold_answer_kind": "entity", "numeric_match": null, "parse_ok": true, "pred_abstain": false, "pred_answer_kind": "numeric"}, "scorer_version": "v2_unit_norm"}
