# Copy to .env and replace placeholders. Never commit real keys or certificates.

# Agent runtime (inside containers)
AGENT_INDEX_PATH=results/full_index_v2/bge_small
AGENT_STATE_DB=/app/results/agent_state.sqlite

# LLM endpoint (read from environment; no baked-in secrets)
LLM_CHAT_URL=http://replace-me/v1/chat/completions
LLM_MODEL=replace-me
LLM_API_KEY=replace-me
LLM_CA_CERT=
LLM_EMBEDDINGS_URL=http://replace-me/v1/embeddings
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
EMBEDDINGS_API_KEY=
EMBEDDINGS_CA_CERT=

# UI -> API
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT_SECONDS=300

# Optional app settings
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

#LANGFUSE
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Code defaults (added for local/WSL/Windows runs)
# agent token budget
AGENT_TOKEN_BUDGET=12000
# question watchdog seconds; eval sets 600
AGENT_RUN_TIMEOUT=300
# legacy watchdog alias
AGENT_QUESTION_TIMEOUT_SECONDS=120
# meta cache directory
AGENT_META_CACHE_DIR=data/cache
# session log directory
AGENT_SESSION_LOG_DIR=data/sessions
# default gold path
GOLD_PATH=data/eval/datasets/gold_v2_eval_v8_public.jsonl
# fallback backend URL
FASTAPI_URL=http://127.0.0.1:8000
# reflection loop max iterations
REFLECTION_MAX_ITERATIONS=2
# reflection loop token cap
REFLECTION_MAX_TOTAL_TOKENS=4000
# chat max tokens
MAX_TOKENS_CHAT=4096
# embedding max tokens
MAX_TOKENS_EMBEDDING=512
# session TTL seconds
SESSION_TTL_SECONDS=3600
# cache TTL seconds
CACHE_TTL_SECONDS=3600
# required by config loader; set when using load_config
INDEX_FREEZE_VERSION=
# prompt set hash
PROMPT_SET_HASH=pending
# model params hash
MODEL_PARAMS_HASH=pending
# legacy chat base URL
LLM_BASE_URL=
# legacy embeddings URL alias
EMBEDDINGS_URL=
# legacy embeddings API key alias
LLM_EMBEDDINGS_API_KEY=
# eval scorer OpenAI-compatible base URL
OPENAI_BASE_URL=
# eval scorer API key
OPENAI_API_KEY=
# eval scorer model
OPENAI_MODEL=
# hybrid BM25+dense retrieval off by default
RETRIEVAL_HYBRID=0
# hybrid candidate count
RETRIEVAL_HYBRID_CANDIDATE_K=1000
# rerank on by config default
RETRIEVAL_RERANK=1
# rerank candidate pool
RETRIEVAL_RERANK_POOL=30
# offline Hugging Face cache mode
HF_HUB_OFFLINE=1
# offline Transformers mode
TRANSFORMERS_OFFLINE=1
# OpenMP thread cap
OMP_NUM_THREADS=4
# ONNX Runtime intra-op thread cap
ORT_INTRA_OP_NUM_THREADS=4
# reranker model, cache dir and thread cap
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CACHE_DIR=models/fastembed
RERANK_THREADS=4
# query embedding warm-up timeout seconds
QUERY_EMBED_WARM_TIMEOUT_SECONDS=45
# per-call timeouts seconds (bounded by the request deadline)
LLM_CALL_TIMEOUT_SECONDS=20
EMBED_CALL_TIMEOUT_SECONDS=10
# external call retries (max 2) and backoff delays seconds
EXTERNAL_CALL_MAX_RETRIES=2
EXTERNAL_CALL_BACKOFF_SECONDS=2,4
# agent loop caps (max_steps is hard-capped at 10 in code)
AGENT_MAX_STEPS=10
AGENT_MAX_REVISIONS=3
