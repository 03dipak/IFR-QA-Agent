# LLM stack (<=8B parameters, OpenAI-compatible endpoints)
LLM_CHAT_URL=http://localhost:8000/v1/chat/completions
LLM_EMBEDDINGS_URL=http://localhost:8000/v1/embeddings
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
MAX_TOKENS_CHAT=4096
MAX_TOKENS_EMBEDDING=512

# Session & cache
SESSION_TTL_SECONDS=3600
CACHE_TTL_SECONDS=3600

# Corpus
INDEX_FREEZE_VERSION=corpus-freeze-v1
PROMPT_SET_HASH=pending
MODEL_PARAMS_HASH=pending

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# UI
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0